{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "paths": {
            "@/*": ["./resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "ESNext",
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*.js", "resources/js/**/*.vue", "resources/js/**/*.d.ts", "vite.config.js"],
    "exclude": ["node_modules", "public", "vendor"]
}
